# ── Socle-lite : login local + Cloudflare, sans compte ──
SECRET_KEY=change-me-longue-chaine-aleatoire
SESSION_COOKIE_SECURE=false        # true en prod (HTTPS)

# Marque
BRAND_PREFIX=Mon
BRAND_SUFFIX=Outil
BRAND_BADGE=app

# Cloudflare Access (le portier)
CF_ACCESS_TEAM_DOMAIN=             # ex : super-nono
CF_ACCESS_AUD=                     # AUD de l'application Access
CF_VERIFY_JWT=true                 # false seulement en dev local

# Secours local (LAN). Vide OU ALLOW_LOCAL_LOGIN=false → aucun login local.
ALLOW_LOCAL_LOGIN=true
ADMIN_PASSWORD=

# Optionnel : restreindre AUSSI côté appli (sinon on fait confiance à Cloudflare Access)
# ALLOWED_EMAILS=toi@gmail.com,autre@gmail.com
